<svg class="face-analog" viewBox="-50 -50 100 100" role="img" aria-label="Analog clock">
  <circle r="47" fill="none" stroke="var(--ink)" stroke-width="2" />
  {% for i in (0..11) %}<line y1="-44" y2="-39" stroke="var(--ink)" stroke-width="2" transform="rotate({{ i | times: 30 }})" />{% endfor %}
  <line data-hand="hour" y1="4" y2="-24" stroke="var(--ink)" stroke-width="4" stroke-linecap="round" />
  <line data-hand="minute" y1="6" y2="-36" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round" />
  <line data-hand="second" y1="8" y2="-40" stroke="var(--accent)" stroke-width="1" />
  <circle r="2.5" fill="var(--ink)" />
</svg>
